{
    "compilerOptions": {
        "outDir": "./dist",
        "module": "ESNext",
        "target": "ESNext",
        "removeComments": true,
        "inlineSourceMap": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "watch": true,
        "lib": [
            "ESNext",
            "dom",
            "dom.iterable"
        ]
    },
    "compileOnSave": true,
    "exclude": [
        "./node_modules"
    ]
}